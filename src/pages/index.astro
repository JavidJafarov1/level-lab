---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientButtton from "../components/gradientButtton.astro";
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Level Lab</title>
	</head>
	<body class="p-0">
		<BaseLayout>
			<section
				id="hero"
				class="relative bg-no-repeat bg-cover bg-center 2xl:h-[880px] xl:h-[880px] lg:h-[692px] md:h-[520px] sm:h-[846px] xs:h-[694px] 2xs:h-[566px]"
				style='background-image: url("https://static.tildacdn.com/tild3132-6263-4337-b335-333364626534/1outputcompress-vide.gif");'
			>
				<div
					class="flex justify-center 2xs:w-[288px] xs:w-[361px] sm:w-[448px] md:w-[440px] 2xs:pt-[436px] xs:pt-[516px] sm:pt-[746px] md:pt-[452px] lg:pt-[520px] xl:pt-[620px] 2xl:pt-[620px] mx-auto"
				>
					<GradientButtton className="2xs:text-[20px] xs:text-[20px] sm:text-[20px] md:text-[24px] lg:text-[24px] xl:text-[24px] 2xl:text-[24px]" text="Обсудить задачу" icon="icon1.svg" />
				</div>
			</section>
		</BaseLayout>
		<script>
			function setScrollLayout(element: HTMLElement, secondColumn: HTMLElement) {
			  window.addEventListener("scroll", (ev) => {
				// console.log(window.innerWidth);
				if (window.innerWidth < 1440) return;
				const topSpace = secondColumn.getBoundingClientRect().top;
				const bottomSpace =
				  secondColumn.getBoundingClientRect().bottom - window.innerHeight;
				if (topSpace > 0) {
				  element.classList.remove("client-side-label-center");
				  element.classList.add("client-side-label-top");
				} else if (topSpace < 0 && bottomSpace > 0) {
				  element.classList.remove(
					"client-side-label-top",
					"client-side-label-bottom"
				  );
				  element.classList.add("client-side-label-center");
				} else {
				  element.classList.remove("client-side-label-center");
				  element.classList.add("client-side-label-bottom");
				}
			  });
			}
	  
			setScrollLayout(
			  document.getElementById("client-side-label")!,
			  document.getElementById("clients-right")!
			);
			setScrollLayout(
			  document.getElementById("about-side-label")!,
			  document.getElementById("about-right")!
			);
		  </script>
	</body>
</html>
