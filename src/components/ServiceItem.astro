---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="service-item xl:w-full cursor-pointer" data-expanded="false">
  <div class="flex items-center justify-between px-6 py-5">
    <div class="flex items-center gap-2.5">
      <label class="custom-checkbox" onclick="event.stopPropagation();">
        <input type="checkbox" class="hidden" />
        <span class="checkmark"></span>
      </label>
      <h3 class="text-white text-[14px] font-medium font-rf-expanded-black">{title}</h3>
    </div>
    <button class="transform transition-transform duration-200" data-chevron>
      <svg 
        width="24" 
        height="24" 
        viewBox="0 0 24 24" 
        fill="none" 
        xmlns="http://www.w3.org/2000/svg"
        class="transform transition-transform duration-200"
      >
        <path d="M6 9L12 15L18 9" stroke="white" stroke-width="2"/>
      </svg>
    </button>
  </div>
  <div 
    class="description-content overflow-hidden transition-all duration-200 max-h-0"
  >
    <p class="text-white/60 p-6 pt-0 text-mobile-text md:text-desktop-text">
      {description}
    </p>
  </div>
</div>

<style>
  .service-item {
    background-color: #222222;
    border-radius: 24px;
  }

  .service-item[data-expanded="true"] .description-content {
    max-height: 200px;
  }

  .custom-checkbox {
    display: block;
    position: relative;
    width: 22px;
    height: 22px;
    cursor: pointer;
  }

  .checkmark {
    position: absolute;
    top: 0;
    left: 0;
    width: 22px;
    height: 22px;
    border: 1px solid #DF1B00;
    border-radius: 7px;
    transition: all 0.2s ease;
  }

  .checkmark:after {
    content: "";
    position: absolute;
    left: 8px;
    top: 3px;
    width: 5px;
    height: 10px;
    border: solid black;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  input[type="checkbox"]:checked + .checkmark {
    background-color: #DF1B00;
  }

  input[type="checkbox"]:checked + .checkmark:after {
    opacity: 1;
  }

  .service-item[data-expanded="true"] [data-chevron] svg {
    transform: rotate(180deg);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const serviceItems = document.querySelectorAll('.service-item');
    
    serviceItems.forEach(item => {
      
      item?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isExpanded = item.getAttribute('data-expanded') === 'true';
        item.setAttribute('data-expanded', (!isExpanded).toString());
      });
    });
  });
</script> 