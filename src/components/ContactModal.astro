<div id="contact-modal" class="fixed inset-0 z-[100] hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/80"></div>
    
    <!-- Modal -->
    <div class="relative z-10 min-h-screen w-full flex items-center justify-center px-4">
      <div class="bg-[#111111] w-full max-w-[580px] rounded-2xl p-8 md:p-12">
        <!-- Close button -->
        <div class="flex justify-end mb-8">
          <button id="close-modal-btn" class="text-white hover:text-white/80 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2"/>
            </svg>
          </button>
        </div>
  
        <!-- Content -->
        <div class="text-center mb-12">
          <h2 class="text-white text-2xl md:text-3xl font-bold mb-2">БУДЕТ ZOOM-ВСТРЕЧА</h2>
          <p class="text-white/60 text-sm">Познакомимся и разберем вашу задачу</p>
        </div>
  
        <!-- Form -->
        <form id="contact-form" class="space-y-4">
          <div class="space-y-4">
            <input 
              type="text" 
              placeholder="Имя" 
              class="w-full bg-[#222222] border border-white/10 rounded-lg px-6 py-4 text-white placeholder-white/40 focus:outline-none focus:border-[#FF4B26]"
              required
            />
            <input 
              type="text" 
              placeholder="Telegram" 
              class="w-full bg-[#222222] border border-white/10 rounded-lg px-6 py-4 text-white placeholder-white/40 focus:outline-none focus:border-[#FF4B26]"
              required
            />
            <div class="relative">
              <select 
                class="w-full bg-[#222222] border border-white/10 rounded-lg px-6 py-4 text-white/40 appearance-none focus:outline-none focus:border-[#FF4B26] cursor-pointer"
                required
              >
                <option value="" disabled selected>Ваша задача или вопрос</option>
                <option value="market">Анализ рынка</option>
                <option value="brand">Создание бренда</option>
                <option value="strategy">Маркетинговая стратегия</option>
                <option value="other">Другое</option>
              </select>
              <div class="absolute right-6 top-1/2 -translate-y-1/2 pointer-events-none">
                <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1.5L6 6.5L11 1.5" stroke="white" stroke-width="1.5"/>
                </svg>
              </div>
            </div>
          </div>
  
          <button 
            type="submit"
            class="w-full bg-gradient-to-r from-[#FF4B26] to-[#FF4B26] hover:opacity-90 transition-opacity text-white rounded-lg px-6 py-4 flex items-center justify-center gap-2 group"
          >
            <span>Отправить запрос</span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="transition-transform group-hover:translate-x-1">
              <path d="M4.16669 10H15.8334M15.8334 10L10.8334 5M15.8334 10L10.8334 15" stroke="currentColor" stroke-width="2"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
  
